# Provider keys for the npm-latest @mrgoonie/multix CLI.
# Copy values into your shell environment, project .env, or ~/.multix/.env.
# Never commit real keys.

# Google Gemini: analysis, transcription, extraction, image, video, speech
GEMINI_API_KEY=

# OpenRouter: optional routed image/video generation
OPENROUTER_API_KEY=
OPENROUTER_FALLBACK_MODELS=

# MiniMax: optional image, video, speech, and music generation
MINIMAX_API_KEY=
